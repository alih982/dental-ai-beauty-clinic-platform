# AI Service Environment Variables

# Ollama Configuration
OLLAMA_HOST=http://maggicaihub.com:11434
OLLAMA_MODEL=llama3.2

# Service Configuration
DEBUG=true

# CORS
# ALLOWED_ORIGINS=http://maggicaihub.com:3000,http://maggicaihub.com:8000
ALLOWED_ORIGINS =
[
    "http://maggicai-magicai.runflare.run:3000",
    "http://maggicai-magicai.runflare.run:3000",
    "http://maggicai-magicai.runflare.run:8000",
    "http://maggicai-magicai.runflare.run:5000",
    "http://maggicai-magicai.runflare.run:8000",
    "http://maggicaihub.com", # آدرس فرانت‌اند شما
    "http://magicai.runflare.run" # آدرس بک‌اند شما (اگر از HTTPS استفاده می‌کنید)
    # یا اگر بک‌اند شما روی HTTP هست:
    # "http://magicai.runflare.run"
    "localhost:3000",
    "localhost:8000",
    "maggicai-magicai.runflare.run",
    "magggicai-magicai.runflare.run",
    "localhost",

]

# Redis
REDIS_HOST=http://maggicaihub.com
REDIS_PORT=6379
REDIS_DB=0

# Model Parameters
TEMPERATURE=0.7
MAX_TOKENS=2000
TOP_P=0.9

# RAG & Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=maggicaihub.com
POSTGRES_PORT=5432
POSTGRES_DB=ai_rag_db

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
