# =====================================================
# Smart Health Platform - Environment Variables Template
# =====================================================
# Copy this file to `.env` (for local) or `.env.production` (for production)
# NEVER commit the real .env files!
# =====================================================

# =====================================================
# ENVIRONMENT
# =====================================================
# Options: local | production
ENVIRONMENT=local

# =====================================================
# DJANGO
# =====================================================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =====================================================
# DATABASE (PostgreSQL)
# =====================================================
# --- Local ---
DB_NAME=clinic_db
DB_USER=clinic
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=disable

# --- Production (uncomment and fill) ---
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_strong_password
# DB_HOST=your-db-host.com
# DB_PORT=5432
# DB_SSL_MODE=require

# =====================================================
# REDIS
# =====================================================
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# =====================================================
# CELERY
# =====================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =====================================================
# SECURITY & CORS
# =====================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =====================================================
# AI SERVICE
# =====================================================
# Options: gateway | local | mock
AI_PROVIDER=local
OLLAMA_HOST=http://localhost:11434
AI_SERVICE_URL=http://localhost:8001
# OPENAI_API_KEY=sk-your-key-here
# GEMMA_API_KEY=your-gemini-key-here

# =====================================================
# MLFLOW (Optional)
# =====================================================
MLFLOW_TRACKING_URI=http://localhost:5000

# =====================================================
# EMAIL (SMTP) - Optional
# =====================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# ADMIN_EMAIL=admin@example.com

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=INFO
DB_QUERY_LOGGING=False