# =====================================================
# DJANGO SETTINGS
# =====================================================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-super-secret-key-here-CHANGE-ME-IN-PRODUCTION
DEBUG=False
ALLOWED_HOSTS={
    '185.126.10.222',
    'http://maggicaihub.com',
    'magicai.runflare.run'

}

# =====================================================
# DATABASE (PostgreSQL)
# =====================================================
DB_NAME=postgreshif_db
DB_USER=postgres
DB_PASSWORD=ppIdIZfPaBTFn5h1v8kx
DB_HOST=db
DB_PORT=5432
DB_SSL_MODE=require

# =====================================================
# REDIS
# =====================================================
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# =====================================================
# CELERY
# =====================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =====================================================
# SECURITY & CORS
# =====================================================
# For production, specify exact domains:
CORS_ALLOWED_ORIGINS=http://maggicaihub.com,http://maggicaihub.com,http://www.maggicaihub.com,magicai.runflare.run,magggicai-magicai.runflare.run
CSRF_TRUSTED_ORIGINS=http://maggicaihub.com,http://maggicaihub.com,http://www.maggicaihub.com,magicai.runflare.run,magggicai-magicai.runflare.run

# =====================================================
# AI SERVICE
# =====================================================
# Options: gateway, local, mock
AI_PROVIDER=gateway
OLLAMA_HOST=http://maggicaihub.com:11434
# OPENAI_API_KEY=sk-your-openai-key-here
# GEMMA_API_KEY=your-gemini-key-here
AI_SERVICE_URL=http://ai_service:8001

# =====================================================
# MLFLOW (Optional)
# =====================================================
MLFLOW_TRACKING_URI=http://mlflow:5000

# =====================================================
# EMAIL (SMTP) - Optional
# =====================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# ADMIN_EMAIL=admin@maggicaihub.com

# =====================================================
# PORTS
# =====================================================
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
AI_SERVICE_PORT=8001
API_GATEWAY_PORT=8080

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=INFO

